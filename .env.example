# Backend
SPEND_TRACKER_DB_PATH=data/spend.db

# Use a long random value in real environments. JWT routes are enabled when
# this variable is set.
SPEND_TRACKER_JWT_SECRET=replace-with-a-long-random-secret
SPEND_TRACKER_JWT_EXPIRE_MINUTES=1440

# Optional legacy single-key authentication. JWT is recommended for the React UI.
# SPEND_TRACKER_API_KEY=replace-with-an-api-key

# Comma-separated browser origins allowed to call the API.
SPEND_TRACKER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
